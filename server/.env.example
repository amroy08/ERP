PORT=5001
JWT_SECRET=your_jwt_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d
NODE_ENV=development
UPLOAD_DIR=uploads
CLIENT_URL=http://localhost:5173

# Database Connection URL (MySQL / Prisma)
DATABASE_URL="mysql://root:password@127.0.0.1:3306/school_erp"

# ── Phase 2.6B: Email Notification Config ──────────────────────────
# Master switch — set to true to enable email sending
EMAIL_ENABLED=false
# Provider type (only smtp supported for now)
EMAIL_PROVIDER=smtp
# Test mode — logs email attempts but does not connect to SMTP
EMAIL_TEST_MODE=true
# SMTP Configuration
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=user@example.com
SMTP_PASS=password
SMTP_FROM_EMAIL=noreply@school.local
SMTP_FROM_NAME="School ERP"
