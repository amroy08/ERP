# School ERP Mobile — Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in the values for your environment.
# NEVER commit your .env file to the repository.
# ─────────────────────────────────────────────────────────────────────────────

# API Base URL — uncomment and set the correct value for your environment:
#
# Android Emulator:
#   EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:5001/api
#
# iOS Simulator / macOS localhost:
#   EXPO_PUBLIC_API_BASE_URL=http://localhost:5001/api
#
# Physical device on same LAN (development):
#   EXPO_PUBLIC_API_BASE_URL=http://192.168.1.X:5001/api
#
# Internal/preview build (staging server):
#   EXPO_PUBLIC_API_BASE_URL=http://YOUR_STAGING_IP:5001/api
#
# Production build (HTTPS required for App Store / Play Store):
#   EXPO_PUBLIC_API_BASE_URL=https://api.yourschool.com/api

EXPO_PUBLIC_API_BASE_URL=http://localhost:5001/api
